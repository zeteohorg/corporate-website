# Public variables
PUBLIC_PROJECT_NAME="Your Project Name"
PUBLIC_ORIGIN=
PUBLIC_POSTHOG_KEY=
PUBLIC_DEFAULT_TITLE=
PUBLIC_DEFAULT_DESCRIPTION=

# Private (server-only) — set these as Netlify env vars, never commit values.
# Used by src/routes/api/solution-finder/+server.ts to forward leads to HubSpot
# and email the report. Missing values degrade gracefully (see the endpoint).
#
# HubSpot Forms Submit API. Required for HubSpot capture — read at runtime, never
# hardcoded (Netlify secrets scanning fails the build if an env-var value appears
# literally in source). Set in Netlify env + local .env. Leave HUBSPOT_REGION
# empty to use api.hsforms.com (routes by portal ID for all regions).
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
HUBSPOT_REGION=
# Resend transactional email (report delivery):
RESEND_API_KEY=
REPORT_FROM_EMAIL="zeteoh <reports@zeteoh.com>"
